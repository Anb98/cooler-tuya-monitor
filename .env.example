# --- Temperature thresholds (degrees Celsius) ---
# Fan turns ON when CPU reaches this value.
CPU_TEMP_HIGH=60
# Fan may turn OFF only once CPU has been below this value continuously
# (together with all disks) for OFF_DWELL_SEC.
CPU_TEMP_LOW=48
# Hard safety ceiling: fan is force-enabled even under manual-OFF.
CPU_TEMP_CRITICAL=80

# Fan turns ON when any monitored disk reaches this value.
HDD_TEMP_HIGH=48
# Disks must be below this value (together with CPU) for OFF_DWELL_SEC.
HDD_TEMP_LOW=42
# Hard safety ceiling: fan is force-enabled even under manual-OFF.
HDD_TEMP_CRITICAL=55

# --- Timers (seconds) ---
# How often the control loop polls sensors and evaluates state.
POLL_INTERVAL_SEC=30
# All sources must stay below LOW continuously for this long before the fan
# turns OFF.
OFF_DWELL_SEC=300
# Anti-short-cycling: once ON, the fan stays ON for at least this long.
MIN_ON_SEC=120

# --- Hardware ---
# Comma-separated list of disk device names (without /dev/ prefix) to poll
# via smartctl. Each must match /dev/sd[a-z]+ after prefixing.
HDD_DEVICES=sda,sdb,sdc,sdd,sde

# --- Tuya local LAN credentials (required) ---
# Device ID from the Tuya IoT Platform (see README for extraction guide).
TUYA_DEVICE_ID=
# Local key from the Tuya IoT Platform / tuya-cli wizard.
TUYA_LOCAL_KEY=
# Local IP address of the smart plug on your LAN.
TUYA_IP=
# Tuya local protocol version reported by the wizard (e.g. 3.3, 3.4).
TUYA_VERSION=3.3

# --- Operating mode flags ---
# When true, no real Tuya commands are sent; decisions are only logged.
DRY_RUN=false
# When true (default, recommended), sensor/comms failures force the fan ON
# instead of leaving it in an uncertain state.
FAIL_SAFE=true
# Enable the Fastify HTTP API (/health, /status, /fan/on, /fan/off, /fan/auto).
HTTP_ENABLED=true
# HTTP listen port.
PORT=3000
# HTTP bind address. Defaults to 0.0.0.0 (reachable on the LAN via
# network_mode: host). The control API is UNAUTHENTICATED — set this to
# 127.0.0.1 to restrict it to localhost only. See the security note in README.
HTTP_HOST=0.0.0.0

# --- Logging ---
# pino log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info
